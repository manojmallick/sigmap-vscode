{
  "name": "sigmap",
  "displayName": "SigMap — AI Context Engine",
  "description": "96.9% token reduction for Copilot, Claude & Cursor. Extracts code signatures from 33 languages into copilot-instructions.md automatically.",
  "version": "4.4.0",
  "publisher": "manojmallick",
  "engines": {
    "vscode": "^1.101.0"
  },
  "icon": "icon.png",
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "copilot",
    "github copilot",
    "claude",
    "cursor",
    "ai context",
    "token reduction",
    "code signatures",
    "sigmap",
    "context",
    "llm",
    "zero-dependency",
    "mcp",
    "copilot-instructions",
    "windsurf",
    "gemini",
    "codebase context",
    "typescript",
    "python",
    "go",
    "openai",
    "codex"
  ],
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "qna": "https://github.com/manojmallick/sigmap/issues",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "languageModelTools": [
      {
        "name": "sigmap_query",
        "displayName": "SigMap Query",
        "toolReferenceName": "sigmap",
        "canBeReferencedInPrompt": true,
        "icon": "$(file-code)",
        "userDescription": "Rank the most relevant workspace files for a task using SigMap's code-signature index",
        "modelDescription": "Ranks the most relevant files in the current workspace for a natural-language query using SigMap's code-signature index (function/class signatures, not full text). Returns the top files with their key signatures. Call this BEFORE grep/file searches to locate where functionality lives — it is faster and far cheaper than reading files.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Natural-language description of the code to find, e.g. 'where is authentication handled'"
            },
            "top": {
              "type": "number",
              "description": "Maximum number of ranked files to return (default 10, max 25)"
            }
          },
          "required": [
            "query"
          ]
        }
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "sigmap.mcpServers",
        "label": "SigMap MCP"
      }
    ],
    "commands": [
      {
        "command": "sigmap.regenerate",
        "title": "SigMap: Regenerate Context"
      },
      {
        "command": "sigmap.openContext",
        "title": "SigMap: Open Context File"
      },
      {
        "command": "sigmap.queryContext",
        "title": "SigMap: Query Context"
      }
    ],
    "configuration": {
      "title": "SigMap",
      "properties": {
        "sigmap.scriptPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to gen-context.js. Leave empty to auto-detect from workspace root."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/manojmallick/sigmap-vscode.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/manojmallick/sigmap-vscode/issues"
  },
  "homepage": "https://manojmallick.github.io/sigmap/",
  "scripts": {
    "test": "jest --testPathPattern=test/",
    "test:watch": "jest --watch --testPathPattern=test/"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  }
}
